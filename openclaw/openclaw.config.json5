// ===========================================================================
//  MERGE THIS BY HAND. DO NOT BLIND-OVERWRITE ~/.openclaw/openclaw.json.
// ===========================================================================
//
//  This file is a *fragment*, not a complete OpenClaw config. Your real
//  config at ~/.openclaw/openclaw.json already contains keys written by
//  `openclaw onboard` (gateway identity, auth, channels) that are not
//  reproduced here. Copying this file over it will break your install.
//
//  To apply it:
//    1. Back up first:
//         cp ~/.openclaw/openclaw.json ~/.openclaw/openclaw.json.bak
//    2. Open ~/.openclaw/openclaw.json and merge the keys below into it,
//       key by key. It is JSON5, so these comments are legal there too --
//       keep the ones that explain a choice.
//    3. Validate:
//         openclaw doctor
//    4. Restart the gateway and confirm it comes up on :18789.
//
//  IF THE GATEWAY FAILS TO START AFTER AN EDIT, run:
//         openclaw doctor --non-interactive
//  A single bad key can crash the gateway, and a crashed gateway can
//  silently lose its Full Disk Access grant -- so a config typo shows up as
//  "my files disappeared", not as a parse error. Always `openclaw doctor`
//  after editing, never assume.
//
//  mitsync does not require any of this. The CLI is fully usable from a
//  terminal with no OpenClaw installed; this fragment only adds scheduling
//  and a chat surface.
// ===========================================================================

{
  // -----------------------------------------------------------------------
  // Workspace
  // -----------------------------------------------------------------------
  // The MIT courses directory. This is also where skills are discovered
  // from (<workspace>/skills, which openclaw/install.sh symlinks to
  // _agent/skills) and what tools.fs.workspaceOnly confines file access to.
  //
  // NOTE: ~/Desktop is itself TCC-gated on macOS. The gateway runs as a
  // LaunchAgent, which is a different code identity than your terminal, and
  // needs its own Full Disk Access / Desktop grant. See docs/RUNBOOK.md.
  workspace: "/Users/filippostrub/Desktop/MIT/courses",

  tools: {
    fs: {
      // Refuse all filesystem access outside the workspace above. This is
      // the single most valuable key here: Canvas content is untrusted
      // input, and this bounds the blast radius of anything it talks the
      // model into trying.
      workspaceOnly: true,
    },

    exec: {
      // deny | allowlist | ask | auto | full
      //
      // "allowlist": only the exact commands listed below run without a
      // prompt; everything else is refused. Do NOT relax this to "auto" or
      // "full" -- the agent regularly reads Canvas-authored text, and an
      // unbounded shell is the one thing that turns a prompt injection into
      // a real incident.
      //
      // Allow-always entries bind to the EXACT argv AND cwd. A different
      // flag, a different flag order, or a different cwd is a different
      // command and will not match. That is deliberate. It also means this
      // list must be kept in step with what the skills actually run -- if a
      // skill starts passing a new flag, add the entry, do not widen the
      // mode.
      mode: "allowlist",

      allow: [
        // --- mit-canvas-sync -------------------------------------------
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "sync"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "sync", "--dry-run"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "doctor"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },

        // --- mit-organize ----------------------------------------------
        // `organize plan` is read-only (it writes a plan file and nothing
        // else), so it is safe to auto-approve.
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "organize", "plan"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "map"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        //
        // DELIBERATELY ABSENT, and they should stay absent:
        //   mitsync organize apply            (moves files)
        //   mitsync organize apply --yes      (moves files, no prompt)
        //   mitsync organize plan --include-existing
        //   mitsync organize undo
        //   mitsync map --apply               (writes config/courses.yml)
        // These mutate the student's own folders or config. They must hit
        // an approval prompt every time. Letting the exact-argv match cover
        // `--yes` would delete the entire human gate in mit-organize.

        // --- mit-briefing ----------------------------------------------
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "due"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "brief"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "calendar"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },

        // --- mit-kb ------------------------------------------------------
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "extract"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "graph", "extract"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "graph", "rebuild"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["uv", "run", "--project", "/Users/filippostrub/Desktop/MIT/courses/_agent", "mitsync", "kb", "build"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        // `graph query` is parameterized by --sql / --canned, so its argv is
        // not fixed and cannot be pinned here. It will prompt. That is the
        // right trade: raw SQL typed by a model that has just read untrusted
        // course PDFs deserves a look before it runs.

        // --- the calendar binary ---------------------------------------
        // Read-only EventKit CLI (settings.yml -> calendar.cli). mitsync
        // shells out to it; pinning it here avoids a prompt per briefing.
        // Adjust the path to match `command -v ical-guy` on this machine --
        // exact-argv matching means a wrong path silently never matches.
        {
          // v0.13.0: `events list`, date-only --from/--to, and an explicit
          // --group-by none so a user config file cannot change the shape.
          // NOTE: exact-argv pinning cannot express the varying date
          // values, so this entry matches the prefix convention used
          // above; verify against `command -v ical-guy` (here:
          // ~/.local/bin/ical-guy, NOT Homebrew -- the formula did not build).
          argv: ["/Users/filippostrub/.local/bin/ical-guy", "events", "list"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },

        // --- the cron wrapper -------------------------------------------
        // What the scheduled jobs actually execute. One entry per subcommand,
        // since argv must match exactly.
        {
          argv: ["/Users/filippostrub/Desktop/MIT/courses/_agent/scripts/mitsync-cron.sh", "sync"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["/Users/filippostrub/Desktop/MIT/courses/_agent/scripts/mitsync-cron.sh", "brief"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
        {
          argv: ["/Users/filippostrub/Desktop/MIT/courses/_agent/scripts/mitsync-cron.sh", "verify"],
          cwd: "/Users/filippostrub/Desktop/MIT/courses/_agent",
        },
      ],
    },
  },

  // -------------------------------------------------------------------------
  // Model default
  // -------------------------------------------------------------------------
  agents: {
    defaults: {
      // Matches llm.model in _agent/config/settings.yml so the chat surface
      // and mitsync's own `--driver api` path (if a key is ever set) agree on
      // which model made a judgment call.
      model: {
        primary: "claude-opus-5",
      },
    },
  },

  // -------------------------------------------------------------------------
  // MCP servers
  // -------------------------------------------------------------------------
  // mitsync is a CLI, not an MCP server, so it needs nothing here. Declared
  // empty on purpose: an MCP server would be a second, unpinned path to the
  // filesystem that tools.exec.mode would not be governing.
  mcp: {
    servers: {},
  },

  // -------------------------------------------------------------------------
  // Environment
  // -------------------------------------------------------------------------
  // Secrets live in ~/.openclaw/.env, never in this file and never in the
  // repo. Create it with mode 0600:
  //
  //   touch ~/.openclaw/.env && chmod 600 ~/.openclaw/.env
  //   printf 'CANVAS_TOKEN=%s\n' '<token from Canvas > Account > Settings>' \
  //     >> ~/.openclaw/.env
  //
  // CANVAS_TOKEN is the variable name mitsync reads (config/settings.yml ->
  // canvas.token_env). It is the only secret mitsync needs.
  //
  // ANTHROPIC_API_KEY is intentionally NOT set for mitsync's benefit. With no
  // key, mitsync's judgment driver resolves to `agent`, which means the
  // OpenClaw model itself is the judge via the exit-20 / `mitsync resolve`
  // protocol. Setting a key here would silently switch mitsync to `--driver
  // api` and start spending tokens out-of-band.
  env: {
    file: "~/.openclaw/.env",
  },
}
