#!/bin/bash
#
# mitsync-agent -- the one executable an autonomous agent (OpenClaw) may run.
#
#   mitsync-agent brief            same arguments as `mitsync`
#
# OpenClaw's exec allowlist matches on the binary's path, so allowlisting this
# file (instead of `uv`, which runs anything) scopes the agent to mitsync. It
# also refuses what only a human may do, however persuasive a Canvas page is:
#
#   organize undo                         reverses a filing; a human decides that
#   organize apply --include-existing     would MOVE the student's own files
#   forum ...                             the forum agent's, through bin/mitsync-forum
#
# Plain `organize apply --plan P --yes` is allowed: it only hardlinks or
# copies newly mirrored Canvas files into the course folders (replacing at most
# mitsync's own unchanged copy of an older deck), rejects any placement that
# touches a pre-existing file, and writes an undo log.
#
# A LaunchAgent has no shell profile, so uv is looked up by absolute path.

set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

case " $* " in
  *" organize "*"undo "*)
    echo "mitsync-agent: organize undo changes the student's folders; a human" >&2
    echo "runs it from a terminal. Say which undo log you would reverse instead." >&2
    exit 2
    ;;
  *" organize "*"apply "*"--include-existing"* | *" organize "*"--include-existing"*)
    echo "mitsync-agent: --include-existing moves the student's own files; a human" >&2
    echo "runs that from a terminal after reviewing the plan. Present the plan instead." >&2
    exit 2
    ;;
esac

if [ "${1:-}" = forum ]; then
  echo "mitsync-agent: the Canvas forum belongs to the separate forum agent" >&2
  echo "(bin/mitsync-forum); this agent never writes to Canvas." >&2
  exit 2
fi

for uv in "${HOME}/.local/bin/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
  [ -x "${uv}" ] && exec "${uv}" run --quiet --project "${REPO}" mitsync "$@"
done
echo "mitsync-agent: uv not found in ~/.local/bin, /opt/homebrew/bin or /usr/local/bin" >&2
exit 1
