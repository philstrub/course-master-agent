{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Morning brief (written by the agent)",
  "description": "The agent's judgment for one morning. `mitsync email` adds the facts (today's calendar, sync freshness), renders the dashboard and sends it. Everything here is shown to the student verbatim.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "headline",
    "homework",
    "gaps"
  ],
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "headline": {
      "type": "string",
      "maxLength": 100,
      "description": "One line: the single most urgent thing."
    },
    "homework": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "course",
          "title",
          "due_at",
          "urgency",
          "status",
          "progress",
          "summary",
          "next_step",
          "review",
          "effort_hours"
        ],
        "properties": {
          "course": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "due_at": {
            "type": "string",
            "description": "ISO 8601 with offset, as `mitsync due --json` gives it"
          },
          "urgency": {
            "enum": [
              "now",
              "soon",
              "later"
            ],
            "description": "now: due within 48 h; soon: 2-4 days; later: 5+ days"
          },
          "status": {
            "enum": [
              "ready_to_submit",
              "in_progress",
              "not_started",
              "submitted",
              "unknown"
            ]
          },
          "progress": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Share of the handout's parts with work in them; null if you could not tell"
          },
          "summary": {
            "type": "string",
            "maxLength": 160,
            "description": "The evidence, e.g. 'Q1-Q3 done in Deliverable_1.tex, Q4 untouched'. Not shown in the email; tomorrow's run reads it."
          },
          "next_step": {
            "type": "string",
            "maxLength": 120
          },
          "review": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "where",
                "why"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "description": "workspace-relative path"
                },
                "where": {
                  "type": "string",
                  "description": "slides / pages / section",
                  "maxLength": 40
                },
                "why": {
                  "type": "string",
                  "description": "which remaining question it serves",
                  "maxLength": 60
                }
              }
            }
          },
          "effort_hours": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 140
      },
      "description": "What you could not see or verify, one short sentence each. Empty if nothing.",
      "maxItems": 3
    }
  }
}
