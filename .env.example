# Copy to .env and fill in. Never commit .env (it is gitignored).
#
# mitsync loads these files at startup, highest precedence first:
#   1. _agent/.env          (this file, once copied)
#   2. ~/.openclaw/.env     (the OpenClaw gateway's secrets file, mode 600)
# The first file to define a key wins. A variable already present in the real
# environment ALWAYS wins over both -- OpenClaw and cron wrappers inject vars
# deliberately, and a stale .env must never clobber them.
# Set MITSYNC_DOTENV=0 to switch .env loading off entirely (debugging escape
# hatch); `mitsync doctor` reports which source each secret came from.

# Canvas LMS personal access token (Account > Settings > New Access Token)
CANVAS_TOKEN=

# Override the workspace root (defaults to the parent of this repo)
# MITSYNC_WORKSPACE=/Users/you/Desktop/MIT/courses

# Gmail app password for `mitsync email` (Google Account > Security > App passwords)
GMAIL_APP_PASSWORD=
