# Copy to .env and fill in. Never commit .env.

# Canvas LMS personal access token (Account > Settings > New Access Token)
CANVAS_TOKEN=

# LLM API key for the `api` driver. The variable NAME is configured in
# config/settings.yml under llm.api_key_env -- change both together.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Override the workspace root (defaults to the parent of this repo)
# MITSYNC_WORKSPACE=/Users/you/Desktop/MIT/courses
